{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aafp-commons.org/schema/constitution-installation@1",
  "title": "AAFP Commons constitution installation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "installed"],
  "properties": {
    "schema": {"const": "aafp.commons/constitution-installation@1"},
    "installed": {"type": "boolean"},
    "error": {"type": "string"},
    "count": {"type": "integer", "minimum": 0},
    "package_id": {"type": "string"},
    "version": {"type": "string"},
    "constitution_id": {"type": "string"},
    "constitution_version": {"type": "string"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "constitutions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["constitution_id", "version", "digest"],
      "properties": {
        "constitution_id": {"type": "string"}, "version": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }}
  }
}
