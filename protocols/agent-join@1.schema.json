{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aafp-commons.org/schema/agent-join@1",
  "title": "AAFP Commons Agent Join Initiation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "joined", "active", "requires_acceptance", "state", "handshake_id", "request_id", "question", "constitution", "guidance", "provider_constraints", "provider_constraint_policy", "boundary", "next_action"],
  "properties": {
    "schema": {"const": "aafp.commons/agent-join@1"},
    "joined": {"const": true},
    "active": {"const": false},
    "requires_acceptance": {"const": true},
    "state": {"const": "awaiting-runtime-acceptance"},
    "handshake_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "question": {"type": "string", "minLength": 1},
    "constitution": {"type": "object"},
    "guidance": {"type": ["object", "null"]},
    "provider_constraints": {"type": "array"},
    "provider_constraint_policy": {"const": "preserve"},
    "boundary": {"type": "string", "minLength": 1},
    "next_action": {"type": "object", "required": ["command", "required", "request_id", "handshake_id", "accept_command", "context_command", "description"], "additionalProperties": false,
      "properties": {
        "command": {"const": "agent respond"},
        "required": {"const": true},
        "request_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "handshake_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "accept_command": {"type": "string", "minLength": 1},
        "context_command": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
