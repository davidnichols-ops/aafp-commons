{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aafp-commons.org/schema/runtime-handshake@1",
  "title": "AAFP Commons Runtime Handshake",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime", "runtime_version", "identity_convention", "identity_hint", "accepted_constitutions", "declared_at", "schema"],
  "properties": {
    "runtime": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "runtime_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "identity_convention": {"enum": ["aafp-sha256-pubkey", "runtime-native", "unspecified"]},
    "identity_hint": {"type": "string", "maxLength": 500},
    "accepted_constitutions": {"type": "array", "items": {"$ref": "#/$defs/constitutionRef"}, "uniqueItems": true},
    "declared_at": {"type": "integer", "minimum": 0},
    "schema": {"const": "aafp.commons/runtime-handshake@1"}
  },
  "$defs": {
    "constitutionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constitution_id", "version", "digest"],
      "properties": {
        "constitution_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[0-9][0-9A-Za-z._+-]{0,63}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
